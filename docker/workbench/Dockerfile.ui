# Built workbench behind nginx. The browser talks to this origin only;
# nginx proxies /v1 and /health to the API on the compose network.

FROM node:22-alpine AS build

WORKDIR /src

COPY workbench/package.json workbench/package-lock.json ./
RUN npm ci

COPY workbench/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY docker/workbench/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /src/dist /usr/share/nginx/html

EXPOSE 8080
